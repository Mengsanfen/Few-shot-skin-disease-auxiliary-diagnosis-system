# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# 数据库。默认 SQLite；如需 MySQL，将 DB_ENGINE 改为 mysql 并填写连接信息。
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
DB_NAME=medical_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 通用医疗大模型配置（问诊 RAG 与图像诊断解读共用）
DASHSCOPE_API_KEY=
MEDICAL_LLM_API_KEY=
MEDICAL_LLM_BASE_URL=
MEDICAL_LLM_MODEL=deepseek-chat
MEDICAL_VISION_MODEL=qwen3.6-plus
MEDICAL_VISION_SEND_IMAGE=True
MEDICAL_LLM_TIMEOUT=60

# 兼容旧 DeepSeek 配置；如果不填 MEDICAL_LLM_*，系统会读取下面两个变量
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com

# 可选：Neo4j 知识图谱后端。未填写时使用数据库知识表构建轻量图谱路径。
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# 可选：讯飞星火聊天接口
SPARK_APPID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_URL=wss://spark-api.xf-yun.com/v4.0/chat
SPARK_DOMAIN=4.0Ultra

# 可选：Landing AI 细胞/目标检测接口
OBJECT_DETECTION_API_KEY=
OBJECT_DETECTION_URL=https://api.va.landing.ai/v1/tools/agentic-object-detection

# 可选：页面右下角第三方聊天组件
INFERENCE_DEVICE=auto
SKIN_DEVICE=
YOLO_DEVICE=
YOLO_HALF=False
FSL_SKIN_PATH=D:/AI/FSL_skin

COZE_TOKEN=
COZE_BOT_ID=
